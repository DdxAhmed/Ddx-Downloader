{
  "name": "ddx-downloader",
  "version": "1.0.0",
  "description": "Production-quality open-source desktop application for downloading YouTube videos, educational courses, playlists, and online media.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "DDX Downloader Contributors",
  "license": "MIT",
  "homepage": "https://github.com/DdxAhmed/Ddx-Downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/DdxAhmed/Ddx-Downloader.git"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "node scripts/build-electron.mjs --watch",
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ddx.downloader",
    "productName": "DDX Downloader",
    "publish": {
      "provider": "github",
      "owner": "DdxAhmed",
      "repo": "Ddx-Downloader"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/sql.js": "^1.4.11",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
